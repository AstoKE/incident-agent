# Log file to watch
LOG_PATH=./data/sample.log.jsonl

# Ollama LLM settings
# Chat model used for RCA. qwen3.5:9b fits fully in 12 GB VRAM.
# Bigger/newer option: qwen3.8:27b (18 GB — needs ~20 GB VRAM, otherwise spills to CPU and is slow)
OLLAMA_MODEL=qwen3.5:9b
# Embedding model used for RAG (ChromaDB). Changing it starts a fresh history collection.
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_BASE_URL=http://localhost:11434
# Thinking mode for qwen3.x: false = fast, true = slower but deeper reasoning.
# Leave empty for models without thinking support (e.g. llama3.1).
OLLAMA_REASONING=false
OLLAMA_NUM_CTX=8192

# Incident detection thresholds
ERROR_THRESHOLD=5
WINDOW_LINES=200

# Daemon mode: seconds between file-change checks
POLL_INTERVAL_SECONDS=30

# ChromaDB (RAG incident history)
# Leave CHROMA_HOST empty to use a local persistent store at CHROMA_DATA_DIR
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_DATA_DIR=./.chromadb
